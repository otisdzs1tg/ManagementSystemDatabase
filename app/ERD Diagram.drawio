<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="GgTyv7WGIJbRid-afqzv">
    <mxGraphModel dx="7308" dy="3356" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\n!define TABLE(name,desc) class name as \&quot;desc\&quot; &lt;&lt; (T,#FFAAAA) &gt;&gt;\n\n!define PK(x) &lt;u&gt;x&lt;/u&gt;\n\n!define FK(x) &lt;i&gt;x&lt;/i&gt;\n\n!define UK(x) &lt;color:blue&gt;x&lt;/color&gt;\n\n\n\nskinparam classAttributeIconSize 0\n\nskinparam class {\n\n    BackgroundColor #FFF8F0\n\n    BorderColor #8B6914\n\n    HeaderBackgroundColor #D4A96A\n\n    HeaderFontColor #3B1F00\n\n    FontSize 12\n\n    FontName Arial\n\n    ArrowColor #8B6914\n\n}\n\nskinparam stereotypeCBackgroundColor #E8C97A\n\nskinparam shadowing false\n\nskinparam nodesep 60\n\nskinparam ranksep 80\n\n\n\n&#39; ─────────────────────────────────────────────\n\n&#39;  USERS\n\n&#39; ─────────────────────────────────────────────\n\nTABLE(USERS, \&quot;USERS\&quot;) {\n\n    PK(id) : INT AUTO_INCREMENT\n\n    UK(email) : VARCHAR(255) UNIQUE NOT NULL\n\n    password_hash : VARCHAR(255) NOT NULL\n\n    full_name : VARCHAR(255) NOT NULL\n\n    phone : VARCHAR(20)\n\n    role : ENUM(&#39;staff&#39;,&#39;pos&#39;,&#39;manager&#39;) NOT NULL\n\n    position : VARCHAR(100)\n\n    hourly_rate : DECIMAL(10,2)\n\n    is_active : BOOLEAN DEFAULT TRUE\n\n    created_at : TIMESTAMP\n\n    updated_at : TIMESTAMP\n\n}\n\n\n\n&#39; ─────────────────────────────────────────────\n\n&#39;  SCHEDULES\n\n&#39; ─────────────────────────────────────────────\n\nTABLE(SCHEDULES, \&quot;SCHEDULES\&quot;) {\n\n    PK(id) : INT AUTO_INCREMENT\n\n    FK(user_id) : INT NOT NULL\n\n    date : DATE NOT NULL\n\n    shift_type : ENUM(&#39;morning&#39;,&#39;lunch&#39;,&#39;afternoon&#39;,&#39;evening&#39;) NOT NULL\n\n    status : ENUM(&#39;pending&#39;,&#39;approved&#39;,&#39;rejected&#39;) DEFAULT &#39;pending&#39;\n\n    created_at : TIMESTAMP\n\n    --\n\n    UK(UNIQUE) : (user_id, date, shift_type)\n\n}\n\n\n\n&#39; ─────────────────────────────────────────────\n\n&#39;  ATTENDANCE\n\n&#39; ─────────────────────────────────────────────\n\nTABLE(ATTENDANCE, \&quot;ATTENDANCE\&quot;) {\n\n    PK(id) : INT AUTO_INCREMENT\n\n    FK(user_id) : INT NOT NULL\n\n    FK(schedule_id) : INT NOT NULL\n\n    check_in : TIMESTAMP NOT NULL\n\n    check_out : TIMESTAMP NULL\n\n    fingerprint_data : TEXT\n\n    is_late : BOOLEAN DEFAULT FALSE\n\n    notes : TEXT\n\n}\n\n\n\n&#39; ─────────────────────────────────────────────\n\n&#39;  LEAVE_REQUESTS\n\n&#39; ─────────────────────────────────────────────\n\nTABLE(LEAVE_REQUESTS, \&quot;LEAVE_REQUESTS\&quot;) {\n\n    PK(id) : INT AUTO_INCREMENT\n\n    FK(user_id) : INT NOT NULL\n\n    start_date : DATE NOT NULL\n\n    end_date : DATE NOT NULL\n\n    reason : TEXT NOT NULL\n\n    status : ENUM(&#39;pending&#39;,&#39;approved&#39;,&#39;rejected&#39;) DEFAULT &#39;pending&#39;\n\nFK(approved_by) : INT NULL\n\n    request_date : TIMESTAMP\n\n}\n\n\n\n&#39; ─────────────────────────────────────────────\n\n&#39;  SALARY\n\n&#39; ─────────────────────────────────────────────\n\nTABLE(SALARY, \&quot;SALARY\&quot;) {\n\n    PK(id) : INT AUTO_INCREMENT\n\n    FK(user_id) : INT NOT NULL\n\n    month : INT NOT NULL\n\n    year : INT NOT NULL\n\n    total_hours : DECIMAL(10,2) NOT NULL\n\n    base_salary : DECIMAL(15,2) NOT NULL\n\n    bonus : DECIMAL(15,2) DEFAULT 0\n\n    deductions : DECIMAL(15,2) DEFAULT 0\n\n    net_salary : DECIMAL(15,2) NOT NULL\n\n    paid_at : TIMESTAMP NULL\n\n    notes : TEXT\n\n    --\n\n    UK(UNIQUE) : (user_id, month, year)\n\n}\n\n\n\n&#39; ─────────────────────────────────────────────\n\n&#39;  TABLES\n\n&#39; ─────────────────────────────────────────────\n\nTABLE(TABLES, \&quot;TABLES\&quot;) {\n\n    PK(id) : INT AUTO_INCREMENT\n\n    UK(table_number) : VARCHAR(20) UNIQUE NOT NULL\n\n    capacity : INT NOT NULL\n\n    status : ENUM(&#39;available&#39;,&#39;occupied&#39;,&#39;reserved&#39;) DEFAULT &#39;available&#39;\n\n    qr_code : TEXT\n\n    created_at : TIMESTAMP\n\n}\n\n\n\n&#39; ─────────────────────────────────────────────\n\n&#39;  MENU_ITEMS\n\n&#39; ─────────────────────────────────────────────\n\nTABLE(MENU_ITEMS, \&quot;MENU_ITEMS\&quot;) {\n\n    PK(id) : INT AUTO_INCREMENT\n\n    name : VARCHAR(255) NOT NULL\n\n    category : ENUM(&#39;coffee&#39;,&#39;tea&#39;,&#39;smoothie&#39;,&#39;food&#39;,&#39;other&#39;) NOT NULL\n\n    description : TEXT\n\n    price : DECIMAL(10,2) NOT NULL\n\n    cost : DECIMAL(10,2) NOT NULL\n\n    image_url : VARCHAR(500)\n\n    is_available : BOOLEAN DEFAULT TRUE\n\n    created_at : TIMESTAMP\n\n    updated_at : TIMESTAMP\n\n}\n\n\n\n&#39; ─────────────────────────────────────────────\n\n&#39;  ORDERS\n\n&#39; ─────────────────────────────────────────────\n\nTABLE(ORDERS, \&quot;ORDERS\&quot;) {\n\n    PK(id) : INT AUTO_INCREMENT\n\n    UK(order_number) : VARCHAR(50) UNIQUE NOT NULL\n\n    FK(table_id) : INT NULL\n\n    customer_name : VARCHAR(255)\n\n    customer_phone : VARCHAR(20)\n\n    order_type : ENUM(&#39;dine_in&#39;,&#39;takeaway&#39;,&#39;delivery&#39;) NOT NULL\n\n    status : ENUM(&#39;pending&#39;,&#39;preparing&#39;,&#39;ready&#39;,&#39;completed&#39;,&#39;cancelled&#39;)\n\n    FK(created_by) : INT NOT NULL\n\n    total_amount : DECIMAL(15,2) NOT NULL\n\n    discount_amount : DECIMAL(15,2) DEFAULT 0\n\n    final_amount : DECIMAL(15,2) NOT NULL\n\n    payment_method : ENUM(&#39;cash&#39;,&#39;card&#39;,&#39;transfer&#39;)\n\n    payment_status : ENUM(&#39;unpaid&#39;,&#39;paid&#39;,&#39;refunded&#39;)\n\n    created_at : TIMESTAMP\n\n    completed_at : TIMESTAMP NULL\n\n}\n\n&#39; ─────────────────────────────────────────────\n\n&#39;  ORDER_ITEMS\n\n&#39; ─────────────────────────────────────────────\n\nTABLE(ORDER_ITEMS, \&quot;ORDER_ITEMS\&quot;) {\n\n    PK(id) : INT AUTO_INCREMENT\n\n    FK(order_id) : INT NOT NULL\n\n    FK(menu_item_id) : INT NOT NULL\n\n    quantity : INT NOT NULL\n\n    unit_price : DECIMAL(10,2) NOT NULL\n\n    subtotal : DECIMAL(15,2) NOT NULL\n\n    notes : TEXT\n\n    status : ENUM(&#39;pending&#39;,&#39;preparing&#39;,&#39;ready&#39;,&#39;served&#39;)\n\n}\n\n\n\n&#39; ─────────────────────────────────────────────\n\n&#39;  SUPPLIERS\n\n&#39; ─────────────────────────────────────────────\n\nTABLE(SUPPLIERS, \&quot;SUPPLIERS\&quot;) {\n\n    PK(id) : INT AUTO_INCREMENT\n\n    name : VARCHAR(255) NOT NULL\n\n    contact_person : VARCHAR(255)\n\n    phone : VARCHAR(20)\n\n    email : VARCHAR(255)\n\n    address : TEXT\n\n    tax_code : VARCHAR(50)\n\n    is_active : BOOLEAN DEFAULT TRUE\n\n    created_at : TIMESTAMP\n\n}\n\n\n\n&#39; ─────────────────────────────────────────────\n\n&#39;  STOCK\n\n&#39; ─────────────────────────────────────────────\n\nTABLE(STOCK, \&quot;STOCK\&quot;) {\n\n    PK(id) : INT AUTO_INCREMENT\n\n    item_name : VARCHAR(255) NOT NULL\n\n    category : VARCHAR(100)\n\n    unit : VARCHAR(50) NOT NULL\n\n    quantity : DECIMAL(10,2) NOT NULL\n\n    min_quantity : DECIMAL(10,2) NOT NULL\n\n    unit_price : DECIMAL(10,2) NOT NULL\n\n    FK(supplier_id) : INT NULL\n\n    last_restocked : TIMESTAMP NULL\n\n    created_at : TIMESTAMP\n\n}\n\n\n\n&#39; ─────────────────────────────────────────────\n\n&#39;  STOCK_TRANSACTIONS\n\n&#39; ─────────────────────────────────────────────\n\nTABLE(STOCK_TRANSACTIONS, \&quot;STOCK_TRANSACTIONS\&quot;) {\n\n    PK(id) : INT AUTO_INCREMENT\n\n    FK(stock_id) : INT NOT NULL\n\n    transaction_type : ENUM(&#39;in&#39;,&#39;out&#39;,&#39;adjustment&#39;) NOT NULL\n\n    quantity : DECIMAL(10,2) NOT NULL\n\n    unit_price : DECIMAL(10,2) NOT NULL\n\n    total_cost : DECIMAL(15,2) NOT NULL\n\n    reason : TEXT\n\n    FK(performed_by) : INT NOT NULL\n\n    created_at : TIMESTAMP\n\n}\n\n\n\n&#39; ─────────────────────────────────────────────\n\n&#39;  EQUIPMENT\n\n&#39; ─────────────────────────────────────────────\n\nTABLE(EQUIPMENT, \&quot;EQUIPMENT\&quot;) {\n\n    PK(id) : INT AUTO_INCREMENT\n\n    name : VARCHAR(255) NOT NULL\n\n    type : VARCHAR(100)\n\n    purchase_date : DATE\n\n    warranty_expiry : DATE\n\n    status : ENUM(&#39;working&#39;,&#39;maintenance&#39;,&#39;broken&#39;) DEFAULT &#39;working&#39;\n\n    last_maintenance : DATE\n\n    notes : TEXT\n\n    created_at : TIMESTAMP\n\n}\n\n&#39; ─────────────────────────────────────────────\n\n&#39;  POS_FEEDBACK\n\n&#39; ─────────────────────────────────────────────\n\nTABLE(POS_FEEDBACK, \&quot;POS_FEEDBACK\&quot;) {\n\n    PK(id) : INT AUTO_INCREMENT\n\n    FK(pos_user_id) : INT NOT NULL\n\n    feedback_type : ENUM(&#39;stock_shortage&#39;,&#39;equipment_issue&#39;,&#39;staff_shortage&#39;) NOT NULL\n\n    description : TEXT NOT NULL\n\n    priority : ENUM(&#39;low&#39;,&#39;medium&#39;,&#39;high&#39;,&#39;urgent&#39;) DEFAULT &#39;medium&#39;\n\n    status : ENUM(&#39;pending&#39;,&#39;in_progress&#39;,&#39;resolved&#39;) DEFAULT &#39;pending&#39;\n\n    FK(resolved_by) : INT NULL\n\n    created_at : TIMESTAMP\n\n    resolved_at : TIMESTAMP NULL\n\n}\n\n\n\n&#39; ─────────────────────────────────────────────\n\n&#39;  FEEDBACK (Customer)\n\n&#39; ─────────────────────────────────────────────\n\nTABLE(FEEDBACK, \&quot;FEEDBACK\&quot;) {\n\n    PK(id) : INT AUTO_INCREMENT\n\n    FK(order_id) : INT NOT NULL\n\n    customer_name : VARCHAR(255)\n\n    rating : INT NOT NULL\n\n    service_rating : INT\n\n    quality_rating : INT\n\n    ambiance_rating : INT\n\n    comment : TEXT\n\n    created_at : TIMESTAMP\n\n    --\n\n    UK(UNIQUE) : (order_id)\n\n    CHECK : rating BETWEEN 1 AND 5\n\n}\n\n\n\n&#39; ─────────────────────────────────────────────\n\n&#39;  PROMOTIONS\n\n&#39; ─────────────────────────────────────────────\n\nTABLE(PROMOTIONS, \&quot;PROMOTIONS\&quot;) {\n\n    PK(id) : INT AUTO_INCREMENT\n\n    name : VARCHAR(255) NOT NULL\n\n    description : TEXT\n\n    discount_type : ENUM(&#39;percentage&#39;,&#39;fixed_amount&#39;) NOT NULL\n\n    discount_value : DECIMAL(10,2) NOT NULL\n\n    start_date : DATE NOT NULL\n\n    end_date : DATE NOT NULL\n\n    applicable_items : JSON\n\n    min_order_amount : DECIMAL(15,2) DEFAULT 0\n\n    max_discount : DECIMAL(15,2)\n\n    is_active : BOOLEAN DEFAULT TRUE\n\n    FK(created_by) : INT NOT NULL\n\n    created_at : TIMESTAMP\n\n}\n\n\n\n&#39; ─────────────────────────────────────────────\n\n&#39;  RELATIONSHIPS\n\n&#39; ─────────────────────────────────────────────\n\n\n\n&#39; User Management\n\nUSERS \&quot;1\&quot; --o{ \&quot;N\&quot; SCHEDULES : \&quot;user_id\&quot;\n\nUSERS \&quot;1\&quot; --o{ \&quot;N\&quot; ATTENDANCE : \&quot;user_id\&quot;\n\nSCHEDULES \&quot;1\&quot; --o{ \&quot;N\&quot; ATTENDANCE : \&quot;schedule_id\&quot;\n\nUSERS \&quot;1\&quot; --o{ \&quot;N\&quot; LEAVE_REQUESTS : \&quot;user_id\&quot;\n\nUSERS \&quot;1\&quot; --o{ \&quot;N\&quot; LEAVE_REQUESTS : \&quot;approved_by\&quot;\n\nUSERS \&quot;1\&quot; --o{ \&quot;N\&quot; SALARY : \&quot;user_id\&quot;\n\n\n\n&#39; Orders\n\nTABLES \&quot;1\&quot; --o{ \&quot;N\&quot; ORDERS : \&quot;table_id\&quot;\n\nUSERS \&quot;1\&quot; --o{ \&quot;N\&quot; ORDERS : \&quot;created_by\&quot;\n\nORDERS \&quot;1\&quot; --|| \&quot;N\&quot; ORDER_ITEMS : \&quot;order_id\&quot;\n\nMENU_ITEMS \&quot;1\&quot; --o{ \&quot;N\&quot; ORDER_ITEMS : \&quot;menu_item_id\&quot;\n\n\n\n&#39; Inventory\n\nSUPPLIERS \&quot;1\&quot; --o{ \&quot;N\&quot; STOCK : \&quot;supplier_id\&quot;\n\nSTOCK \&quot;1\&quot; --|| \&quot;N\&quot; STOCK_TRANSACTIONS : \&quot;stock_id\&quot;\n\nUSERS \&quot;1\&quot; --o{ \&quot;N\&quot; STOCK_TRANSACTIONS : \&quot;performed_by\&quot;\n\n\n\n&#39; Feedback\n\nORDERS \&quot;1\&quot; --o| \&quot;1\&quot; FEEDBACK : \&quot;order_id\&quot;\n\nUSERS \&quot;1\&quot; --o{ \&quot;N\&quot; POS_FEEDBACK : \&quot;pos_user_id\&quot;\n\nUSERS \&quot;1\&quot; --o{ \&quot;N\&quot; POS_FEEDBACK : \&quot;resolved_by\&quot;\n\n\n\n&#39; Promotions\n\nUSERS \&quot;1\&quot; --o{ \&quot;N\&quot; PROMOTIONS : \&quot;created_by\&quot;\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="dC6Boy4efnM7M3jxSEs5-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
